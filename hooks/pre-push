#!/usr/bin/env bash
# Hook pre-push : build/tests complets selon le(s) langage(s) détecté(s).
set -euo pipefail

source "$(dirname "$0")/lib/common.sh"
source "$(dirname "$0")/lib/lang.sh"
source "$(dirname "$0")/lib/safety.sh"
exit_if_skipped
check_version
cd "$GIT_TOPLEVEL"

# git fournit les refs poussées sur stdin : on les transmet au hook local
REFS="$(cat)"
printf '%s\n' "$REFS" | run_local_hook "$@"

# Nommage des branches poussées (ligne : <ref locale> <sha> <ref distante> <sha>).
# Une suppression (sha local nul) n'est pas vérifiée : retirer une branche mal
# nommée doit rester possible.
if ! skipped branch-name; then
    while read -r _ local_sha remote_ref _; do
        [[ "$remote_ref" == refs/heads/* ]] || continue
        [[ "$local_sha" =~ ^0+$ ]] && continue
        branch="${remote_ref#refs/heads/}"
        if ! branch_name_valid "$branch"; then
            err_t hook.pre_push.1 >&2
            branch_help "$branch"
            exit 1
        fi
    done <<< "$REFS"
fi

# Branches protégées : elles n'évoluent que par Pull Request. Seule la création
# initiale sur le remote est permise (dépôt neuf).
if ! skipped protect-branch; then
    cfg_r protectedBranches "main master"
    PROTECTED="$REPLY"
    while read -r _ _ remote_ref remote_sha; do
        [[ "$remote_ref" == refs/heads/* ]] || continue
        branch="${remote_ref#refs/heads/}"
        [[ " $PROTECTED " == *" $branch "* ]] || continue
        [[ "$remote_sha" =~ ^0+$ ]] && continue
        err_t hook.pre_push.2 "$branch" >&2
        echo_t hook.pre_push.3 >&2
        echo_t hook.pre_push.4 >&2
        exit 1
    done <<<"$REFS"
fi

REMOTE="${1:-origin}"

# Fichiers modifiés par le push de <sha> : depuis l'état distant connu, ou pour
# une nouvelle branche depuis le dernier commit déjà présent sur le remote.
changed_files() {
    local sha="$1" remote_sha="$2" oldest base=""
    if [[ ! "$remote_sha" =~ ^0+$ ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base="$remote_sha"
    else
        oldest="$(git rev-list "$sha" --not --remotes="$REMOTE" | tail -n1)"
        [ -z "$oldest" ] && return 0                       # déjà tout sur le remote
        base="$(git rev-parse -q --verify "$oldest^" || true)" # vide = premier push
    fi
    if [ -n "$base" ]; then
        git diff --name-only "$base" "$sha"
    else
        git ls-tree -r --name-only "$sha"
    fi
}

# Linting des fichiers modifiés (shellcheck, actionlint, etc.) : ce que la CI
# refusera doit être vu avant le push. Désactivable avec repowarden.skip lint.
if ! skipped lint; then
    lint_changed_files() {
        local changed_file rc=0
        while IFS= read -r changed_file; do
            [ -f "$changed_file" ] || continue
            case "$changed_file" in
                *.sh|*.bash)
                    if has shellcheck; then
                        step_t hook.pre_push.lint.run "shellcheck" "$changed_file"
                        shellcheck "$changed_file" || rc=1
                    else
                        warn_t hook.pre_push.lint.missing "shellcheck" "$changed_file"
                        [ -n "${REPOWARDEN_WARN_FILE:-}" ] && return 1
                    fi
                    ;;
                .github/workflows/*.yml|.github/workflows/*.yaml)
                    if has actionlint; then
                        step_t hook.pre_push.lint.run "actionlint" "$changed_file"
                        actionlint "$changed_file" || rc=1
                    else
                        warn_t hook.pre_push.lint.missing "actionlint" "$changed_file"
                        [ -n "${REPOWARDEN_WARN_FILE:-}" ] && return 1
                    fi
                    ;;
            esac
        done
        return "$rc"
    }

    LINT_FAILED=0
    while read -r _ local_sha _ remote_sha; do
        # suppression de branche : rien à lint
        if [ -z "$local_sha" ] || [[ "$local_sha" =~ ^0+$ ]]; then continue; fi
        changed_files "$local_sha" "$remote_sha" | lint_changed_files || LINT_FAILED=1
    done <<<"$REFS"
    [ "$LINT_FAILED" -eq 0 ] || exit 1
fi

skipped tests && { info "Tests désactivés (repowarden.skip)."; exit 0; }

run_tests_for() { test_projects <"$1"; }

TESTED=""
CHANGED="$(git rev-parse --absolute-git-dir)/repowarden-changed-files"
while read -r _ local_sha _ remote_sha; do
    # suppression de branche : rien à tester
    if [ -z "$local_sha" ] || [[ "$local_sha" =~ ^0+$ ]]; then continue; fi
    [[ " $TESTED " == *" $local_sha "* ]] && continue
    TESTED="$TESTED $local_sha"
    changed_files "$local_sha" "$remote_sha" >"$CHANGED"
    if [ ! -s "$CHANGED" ] && [ -z "$(cfg test)" ]; then
        info_t hook.pre_push.5 "${local_sha:0:7}"
        continue
    fi
    # Teste le commit poussé tel qu'il sera sur le serveur
    run_on_commit "$local_sha" run_tests_for "$CHANGED"
done <<<"$REFS"

rm -f "$CHANGED"
[ -n "$TESTED" ] || info_t hook.pre_push.6
ok_t hook.pre_push.7
